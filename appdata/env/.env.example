#fill out and rename to .env

#System
TZ=America/New_York
PUID=1003
PGID=100

#Common
EMAIL=
DOMAIN=website.com
GITHUB_REPO=jamesfpate/homelab

#Cameras
FRIGATE_USER=
FRIGATE_PASS=   

#homeassistant
HA_USER=
HA_PASS=

#postgres
PG_USER=
PG_PASS=

#traefik
TRAEFIK_USER=
TRAEFIK_PASS_HASH=

#namedcheap
NAMECHEAP_DNS_API=

#cloudflare 
CLOUDFLARE_TUNNEL_TOKEN=
CF_DNS_API_TOKEN=

#komodo (core/periphery settings live in /mnt/user/appdata/komodo/compose.env)
KOMODO_DB_USERNAME=
KOMODO_DB_PASSWORD=

#pushover (dyndns notifications; Komodo's alerter is configured in its UI)
PUSHOVER_TOKEN=
PUSHOVER_USER=

#DEV APPS