#fill out and rename to .env

#System
TZ=America/New_York
PUID=1003
PGID=100

#Common
EMAIL=
DOMAIN=website.com

#plex (only needed when first linking a server; claim codes expire after 4 min: https://plex.tv/claim)
PLEX_CLAIM=

#postgres
PG_USER=
PG_PASS=

#traefik
TRAEFIK_USER=
TRAEFIK_PASS_HASH=

#cloudflare 
CLOUDFLARE_TUNNEL_TOKEN=
CF_DNS_API_TOKEN=
CF_ZONE_ID= # jamespate.net overview page > API > Zone ID (used by dyndns)

#komodo
KOMODO_DB_USERNAME=
KOMODO_DB_PASSWORD=
KOMODO_JWT_SECRET= # openssl rand -hex 32
KOMODO_WEBHOOK_SECRET= # openssl rand -hex 32
KOMODO_INIT_ADMIN_USERNAME=
KOMODO_INIT_ADMIN_PASSWORD=

#open webui
OPEN_WEBUI_SECRET_KEY= # openssl rand -hex 32 (keeps logins valid across restarts)

#pushover (dyndns notifications; Komodo's alerter is configured in its UI)
PUSHOVER_TOKEN=
PUSHOVER_USER=

#DEV APPS
